<node id="Liver Dysfunction">
  <data key="d0">mechanism</data>
  <data key="d1">Impairment of liver function, affecting metabolism, detoxification, and synthetic processes.</data>
  <data key="d2">7</data>
</node>
<node id="AST">
  <data key="d0">feature</data>
</node>
