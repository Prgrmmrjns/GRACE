<node id="Metabolic Derangement">
  <data key="d0">mechanism</data>
  <data key="d1">Disruptions in metabolic processes, including glucose metabolism, acid-base balance, and electrolyte abnormalities, often secondary to critical illness or organ dysfunction.</data>
  <data key="d2">15</data>
</node>
