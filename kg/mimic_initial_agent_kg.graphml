<node id="Coagulation Dysfunction / DIC">
  <data key="d0">mechanism</data>
  <data key="d1">Systemic activation of coagulation leading to microvascular thrombosis and consumption of clotting factors, often associated with sepsis or trauma.</data>
  <data key="d2">9</data>
</node>
<node id="Underlying Comorbidities and Risk Factors">
  <data key="d0">mechanism</data>
  <data key="d1">Pre-existing conditions or patient characteristics that increase the risk of critical illness and mortality.</data>
  <data key="d2">16</data>
</node>
