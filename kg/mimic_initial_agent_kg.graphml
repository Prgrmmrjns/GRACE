</node>
<node id="Hematological Abnormalities">
  <data key="d0">mechanism</data>
  <data key="d1">Disorders affecting blood cells and coagulation, contributing to oxygen carrying capacity, infection risk, and bleeding/thrombosis.</data>
  <data key="d2">7</data>
</node>
<node id="Hemoglobingdl">
