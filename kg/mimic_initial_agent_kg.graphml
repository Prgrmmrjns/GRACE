<node id="Cardiovascular Dysfunction / Shock">
  <data key="d0">mechanism</data>
  <data key="d1">Impairment of cardiac function or systemic circulation, leading to inadequate tissue perfusion and oxygen delivery. This can result from various causes including sepsis, hemorrhage, myocardial infarction, or cardiomyopathy.</data>
  <data key="d2">15</data>
</node>
<node id="CVPmmHg">
  <data key="d0">feature</data>
</node>
<node id="CKCPK">
  <data key="d0">feature</data>
</node>
<node id="Dobutaminemg_avg">
  <data key="d0">feature</data>
</node>
<node id="Respiratory Failure / Acute Respiratory Distress Syndrome (ARDS)">
  <data key="d0">mechanism</data>
  <data key="d1">Inability of the lungs to adequately oxygenate blood or eliminate carbon dioxide. ARDS is a severe form characterized by diffuse alveolar damage, pulmonary edema, and refractory hypoxemia.</data>
  <data key="d2">11</data>
</node>
<node id="TotalPEEPLevelcmH2O">
  <data key="d0">feature</data>
</node>
<node id="PCO2VenousmmHg">
  <data key="d0">feature</data>
</node>
<node id="Renal Dysfunction / Acute Kidney Injury (AKI)">
  <data key="d0">mechanism</data>
  <data key="d1">Sudden decrease in kidney function, leading to the accumulation of waste products and fluid imbalance. Often caused by ischemia, toxins, or inflammatory processes.</data>
  <data key="d2">11</data>
</node>
<node id="Creatinineserum">
  <data key="d0">feature</data>
</node>
