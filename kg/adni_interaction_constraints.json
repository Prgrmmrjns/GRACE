  "mechanisms": [
    {
      "name": "Amyloid-beta Pathology and Plaque Deposition",
      "description": "Accumulation of amyloid-beta peptides (A\u03b242, A\u03b240) in the brain leads to the formation of extracellular amyloid plaques, a hallmark of Alzheimer\u2019s disease. Reduced levels of A\u03b242 in cerebrospinal fluid (CSF), as well as increased amyloid detection by PET imaging (AV45, PIB, FBB), correspond with increased amyloid plaque deposition. Early amyloid pathology disrupts neuronal function and synaptic communication, contributing to cognitive decline and progression from CN to MCI and AD.",
      "assigned_features": [
        "ABETA42",
        "ABETA40",
        "PIB",
        "AV45",
        "FBB",
