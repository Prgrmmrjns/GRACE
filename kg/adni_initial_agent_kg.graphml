</node>
<node id="Functional Decline">
  <data key="d0">mechanism</data>
  <data key="d1">Progressive difficulty performing activities of daily living (ADLs) due to cognitive impairment.</data>
  <data key="d2">35</data>
</node>
<node id="Neuropsychiatric Symptoms">
  <data key="d0">mechanism</data>
  <data key="d1">Presence of behavioral and psychological symptoms such as depression, agitation, apathy, anxiety, and sleep disturbances associated with AD.</data>
  <data key="d2">14</data>
</node>
