<node id="Global Clinical Severity and Functional Impact">
  <data key="d0">mechanism</data>
  <data key="d1">Reflects the overall severity of dementia as it affects daily function, independence, and levels of care required. Combines clinical staging and functional performance in daily activities, as captured by staging scales and caregiver-rated questionnaires.</data>
  <data key="d2">7</data>
</node>
<node id="CDGLOBAL">
  <data key="d0">feature</data>
</node>
