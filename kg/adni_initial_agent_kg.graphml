<graph edgedefault="directed"><node id="DIAGNOSIS">
  <data key="d0">target</data>
</node>
<node id="Amyloid Pathology and Deposition">
  <data key="d0">mechanism</data>
  <data key="d1">This mechanism involves the abnormal accumulation of amyloid-beta (Aβ) peptides, particularly Aβ42, in the brain. Deposition of amyloid plaques is a hallmark of Alzheimer's disease (AD) pathology and an early indicator that can predate symptoms. Amyloid pathophysiology is detected via CSF testing and PET imaging, and is associated with downstream neurotoxicity, inflammation, and neurodegeneration.</data>
  <data key="d2">5</data>
</node>
<node id="ABETA40">
  <data key="d0">feature</data>
</node>
<node id="ABETA42">
  <data key="d0">feature</data>
</node>
<node id="PIB">
  <data key="d0">feature</data>
</node>
<node id="AV45">
  <data key="d0">feature</data>
</node>
<node id="FBB">
  <data key="d0">feature</data>
</node>
<node id="Tau Pathology and Neurofibrillary Tangle Formation">
  <data key="d0">mechanism</data>
  <data key="d1">This mechanism focuses on the hyperphosphorylation of tau proteins, leading to intracellular neurofibrillary tangle formation, which disrupts neuronal transport and function. Elevated total tau (TAU) and phosphorylated tau (PTAU) in CSF reflect active neurodegeneration and are closely linked to cognitive impairment in AD.</data>
  <data key="d2">2</data>
</node>
<node id="TAU">
  <data key="d0">feature</data>
</node>
<node id="PTAU">
  <data key="d0">feature</data>
</node>
<node id="Neurodegeneration and Brain Atrophy">
  <data key="d0">mechanism</data>
  <data key="d1">Progressive loss and shrinkage of neurons and synapses, particularly in regions like the hippocampus, entorhinal cortex, and temporal lobes. Structural MRI markers and FDG-PET metabolism changes evidence this mechanism, manifesting as cognitive and functional decline as neurons die and lose connectivity.</data>
  <data key="d2">8</data>
</node>
