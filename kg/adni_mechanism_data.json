  "mechanisms": [
    {
      "name": "Amyloid Beta Accumulation and Plaque Formation",
      "description": "Alzheimer\u2019s disease is centrally characterized by the pathological accumulation of amyloid beta (A\u03b2) peptides, particularly A\u03b242, in the brain. These peptides aggregate to form insoluble plaques, which disrupt neuronal communication and trigger a cascade of neurotoxic events, including oxidative stress, inflammation, and synaptic dysfunction. In ADNI data, this process is reflected by reduced CSF A\u03b242 levels and increased amyloid tracer uptake on PET imaging.",
      "assigned_features": [
        "AGE",
        "ABETA40",
        "ABETA42",
        "PIB",
        "AV45",
        "FBB",
        "FDG",
        "TAU",
