  "mechanisms": [
    {
      "name": "Cardiovascular Instability and Failure",
      "description": "Critical illness often leads to disruptions in hemodynamic stability, including hypotension, arrhythmias, and cardiac failure. Abnormalities in heart rate, mean arterial blood pressure, and central venous pressure reflect poor tissue perfusion and shock, which are strong predictors of mortality. Cardiac biomarkers, such as BNP and CK-CPK, indicate myocardial stress or injury, while comorbidities like heart failure, hypertension, and obesity increase susceptibility to adverse cardiovascular outcomes.",
      "assigned_features": [
        "HRbpm",
        "ABPmmmHg",
        "CVPmmHg",
